{
   "compilerOptions": {
      "target": "ES2022",
      "module": "ESNext",
      "moduleResolution": "bundler",
      "allowImportingTsExtensions": true,
      "lib": ["ES2022", "DOM", "DOM.Iterable"],
      "types": ["node"],
      "skipLibCheck": true,
      "noEmit": true,
      "strict": true,
      "noUnusedLocals": true,
      "noUnusedParameters": true
   },
   "include": ["**/*.ts"]
}
