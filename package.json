{
   "name": "aurora",
   "private": true,
   "version": "1.0.1",
   "type": "module",
   "description": "Aurora: a calm, dark, sci-fi ambient interface for DAWN, the user's own surface over DAWN's WebSocket streams.",
   "license": "GPL-3.0-or-later",
   "engines": {
      "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
   },
   "scripts": {
      "dev": "vite",
      "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tests/tsconfig.json",
      "lint": "eslint .",
      "format": "prettier --write .",
      "format:check": "prettier --check .",
      "check:source": "node scripts/check-source.mjs",
      "check:fixtures": "node scripts/check-fixtures.mjs",
      "build": "tsc && vite build",
      "preview": "vite preview",
      "test": "vitest run",
      "test:watch": "vitest",
      "test:coverage": "vitest run --coverage",
      "test:smoke": "playwright test"
   },
   "devDependencies": {
      "@eslint/js": "10.0.1",
      "@playwright/test": "1.64.1",
      "@types/node": "22.20.5",
      "@types/three": "^0.185.1",
      "@vitejs/plugin-basic-ssl": "2.3.0",
      "@vitest/coverage-v8": "5.0.5",
      "eslint": "10.13.0",
      "eslint-plugin-no-unsanitized": "4.1.5",
      "fast-check": "4.10.2",
      "globals": "17.13.0",
      "jsdom": "30.1.3",
      "parse5": "8.0.1",
      "prettier": "3.9.10",
      "typescript": "6.0.3",
      "typescript-eslint": "8.71.2",
      "vite": "8.3.4",
      "vitest": "5.0.5"
   },
   "dependencies": {
      "@fontsource/ibm-plex-mono": "^5.3.0",
      "@fontsource/ibm-plex-sans": "^5.3.0",
      "@fontsource/orbitron": "^5.3.0",
      "dompurify": "^3.4.17",
      "marked": "^18.1.2",
      "three": "^0.186.1"
   }
}
