#!/bin/bash
#
# Pre-commit hook (tracked framework).  Runs the optional local-only extension
# if present and executable.  The local extension (./pre-commit.local.hook,
# gitignored via *.local.hook) holds per-developer checks that must not live in
# the public repo - notably a personal-name PII filter.  A non-zero exit blocks
# the commit.
#
# Install: ./install-git-hooks.sh
# Bypass:  git commit --no-verify
#

cd "$(git rev-parse --show-toplevel)" || exit 1

RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

if [ -x "./pre-commit.local.hook" ]; then
   ./pre-commit.local.hook
   rc=$?
   if [ "$rc" -ne 0 ]; then
      echo ""
      echo -e "${RED}Local pre-commit extension failed (exit $rc).${NC}"
      echo -e "${YELLOW}Bypass: git commit --no-verify${NC}"
      exit "$rc"
   fi
fi

exit 0
